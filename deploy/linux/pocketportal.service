[Unit]
Description=PocketPortal mobile device lab
After=network.target

[Service]
Type=simple
Environment=POCKETPORTAL_CONFIG=%h/.config/pocketportal/pocketportal.properties
ExecStart=%h/.local/share/pocketportal/current/bin/pocketportal
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
