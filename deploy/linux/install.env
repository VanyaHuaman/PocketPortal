POCKETPORTAL_MINIMUM_JAVA_VERSION=17
POCKETPORTAL_VERIFIED_LINUX_RELEASES="ubuntu:25.10"
POCKETPORTAL_EOL_LINUX_RELEASES="ubuntu:25.10"
POCKETPORTAL_DEBIAN_FAMILY_IDS="debian ubuntu linuxmint pop"
POCKETPORTAL_FEDORA_FAMILY_IDS="fedora rhel centos rocky almalinux"
POCKETPORTAL_SERVICE_NAME=pocketportal.service
POCKETPORTAL_STATUS_PATH=/api/status
POCKETPORTAL_DEVICES_PATH=/api/devices
POCKETPORTAL_HEALTH_URL=http://127.0.0.1:8080
POCKETPORTAL_STARTUP_ATTEMPTS=15
POCKETPORTAL_STARTUP_DELAY_SECONDS=1
