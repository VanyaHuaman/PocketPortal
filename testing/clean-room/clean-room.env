PODMAN_CONNECTION=podman-machine-default
IMAGE_NAME=localhost/pocketportal-clean-room:latest
CONTAINER_NAME_PREFIX=pocketportal-clean-room
CONTAINER_PORT=8080
STATUS_PATH=/api/status
EXPECTED_STATUS_FRAGMENT='"state":"ready"'
DEVICES_PATH=/api/devices
EXPECTED_DEVICE_HTTP_STATUS=503
EXPECTED_DEVICE_ERROR_FRAGMENT='"code":"device_discovery_unavailable"'
STARTUP_ATTEMPTS=30
STARTUP_DELAY_SECONDS=1
